{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ai-daily-qcm",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/official-news-scan",
      "schedule": "30 5 * * *"
    }
  ]
}
