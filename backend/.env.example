# Serveur
PORT=8080
APP_ORIGIN=https://votre-domaine.com
PUBLIC_BASE_URL=https://api.votre-domaine.com

# CinetPay — à récupérer dans votre compte marchand
CINETPAY_APIKEY=remplacer_par_votre_apikey
CINETPAY_SITE_ID=remplacer_par_votre_site_id
CINETPAY_CURRENCY=XOF


# SasPay — clé API secrète à mettre uniquement dans Vercel, jamais dans le frontend.
# Scope recommandé : PAYIN ou BOTH.
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_BASE_URL=https://api.saspay.me/api/v1
SASPAY_COUNTRY=BF
SASPAY_CURRENCY=XOF
SASPAY_NETWORK_ORANGE=orange_bf
SASPAY_NETWORK_MOOV=moov_bf

# Supabase
# SUPABASE_URL et SUPABASE_ANON_KEY peuvent être publics.
# SUPABASE_SERVICE_ROLE_KEY est secret : à mettre uniquement dans Vercel, jamais dans le frontend.
SUPABASE_URL=https://scnhrcjhxqzetkrhhong.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessions candidat
# Optionnel mais recommandé en production : une longue valeur aléatoire.
# Si absent, le backend utilise SUPABASE_SERVICE_ROLE_KEY comme secret de signature.
SESSION_SECRET=
SESSION_DAYS=30

# Sécurité PIN
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# Administration — numéros autorisés à gérer le contenu, séparés par des virgules.
# Exemple: ADMIN_PHONES=+226XXXXXXXX
ADMIN_PHONES=

# Stockage des PDF, Word et images publiés depuis l'administration.
SUPABASE_RESOURCE_BUCKET=reussite-concours-resources
# Taille maximale en octets pour un fichier admin (par défaut environ 4 Mo).
MAX_RESOURCE_FILE_BYTES=4194304

# Notifications inscription / Premium.
# Option e-mail Gmail SMTP : créer un mot de passe d'application Gmail, ne jamais mettre le vrai mot de passe Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Option e-mail API alternative, si utilisée.
RESEND_API_KEY=
RESEND_FROM=
# SMS : utiliser soit un fournisseur HTTP compatible, soit Twilio.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=ConcoursBF
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# IA QCM sourcée et vérifiée dans l'admin.
# OpenRouter/Claude est prioritaire dès que OPENROUTER_API_KEY est renseignée.
# La clé reste uniquement dans Vercel, jamais dans le frontend ni GitHub.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_VERIFIER_MODEL=anthropic/claude-sonnet-5.5
# Recherche web OpenRouter : « basic » privilégie la couverture multilingue.
OPENROUTER_SEARCH_ENGINE=parallel
OPENROUTER_SEARCH_MODE=basic
OPENROUTER_SEARCH_MAX_USES=3
OPENROUTER_SEARCH_MAX_RESULTS=5

# Repli Gemini conservé si OpenRouter est indisponible ou sans crédit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VERIFIER_MODEL=gemini-3.1-pro-preview
AI_QCM_PROVIDER=auto
AI_QCM_FALLBACK_ENABLED=true
AI_QCM_TIMEOUT_MS=35000
AI_QCM_GROUNDING_ENABLED=true
AI_QCM_REQUIRE_VERIFICATION=true
AI_QCM_BATCH_SIZE=5
AI_QCM_MIN_VERIFICATION_SCORE=90
# Sources officielles pour la veille IA des concours (optionnel).
# Format possible: Nom|https://site.bf/actualites;Autre source|https://...
OFFICIAL_NEWS_SOURCES=

# Génération IA quotidienne de PDF QCM à relire dans l’admin.
AI_DAILY_QCM_COUNT=50
AI_QCM_MAX_COUNT=50
AI_DAILY_GROUP_MODE=module
AI_DAILY_QCM_CATEGORIES=Burkina Faso,Culture générale,Histoire-Géo,Mathématiques,Physique-Chimie,Psychotechnique,Français,SVT,Greffier / Droit
AI_DAILY_QCM_LEVELS=Concours,BEPC,BAC,CEP,Licence
AI_DAILY_QCM_PREMIUM=false
AI_DAILY_CRON_SECRET=
